# Copy to apps/api/.env — never commit real secrets or GCP keys.

PORT=8787
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth (change in production; store in Secret Manager on Cloud Run)
AUTH_USERNAME=admin
AUTH_PASSWORD=123456
JWT_SECRET=dev-change-me-jwt-secret-use-long-random-string
SESSION_CRYPTO_SECRET=dev-change-me-session-crypto-secret-32b-min
COOKIE_SECURE=false

# GCP — Worker SA JSON for local real writes (keep under keys/, gitignored)
GCP_PROJECT_ID=feimei-product-voc
GCS_RAW_BUCKET=feimei-product-voc-raw
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/keys/feimei-product-voc-xxxx.json

# When true, skip GCS/BQ writes and keep results in memory (local UI demo)
# Set false + credentials to write BigQuery / GCS
IMPORT_DRY_RUN=true

# 差评分析：单次最多条数（控 token）
# ANALYSIS_MAX_REVIEWS=50

# PackyCode / OpenAI 兼容 Chat Completions（KEY+URL+MODEL 齐才走真 LLM，否则 stub）
# LLM_API_KEY=
# LLM_BASE_URL=https://cf.api.fan/v1
# LLM_API_MODE=responses
# LLM_MODEL=gpt-5.6-sol
# LLM_REASONING_EFFORT=medium
# LLM_MIN_CONFIDENCE=0.35
# LLM_TIMEOUT_MS=45000
